@startuml
!theme plain
skinparam componentStyle uml2
skinparam defaultFontName "SimHei"
skinparam linetype ortho
skinparam nodesep 80
skinparam ranksep 60

' 强制从上到下布局
top to bottom direction

' ==========================================
' 应用接入层
' ==========================================
rectangle "应用接入层" as AppLayer #E3F2FD {
    component "游戏业务应用" as App
    component "负载均衡 (LVS/TGW)" as LB
    App -down-> LB
}

' ==========================================
' Spider 分布式数据库集群
' ==========================================

' ===== 控制层 =====
rectangle "控制与调度层" as ControlLayer #FFF9C4 {
    component "控制节点\n元数据 | 分片规则 | 调度" as ControlNode
}

' ===== 路由层 =====
rectangle "路由计算层" as RoutingLayer #E8F5E9 {
    node "Spider 路由节点 1\n(无状态 SQL 解析)" as Spider1
    node "Spider 路由节点 2\n(无状态 SQL 解析)" as Spider2
}

' ===== 存储层 =====
rectangle "数据存储层" as StorageLayer #FFF3E0 {
    
    database "分片组 1\nMaster + Slave" as Shard1
    database "分片组 2\nMaster + Slave" as Shard2
    database "分片组 3\nMaster + Slave" as Shard3
    
    ' 强制横向排列
    Shard1 -[hidden]right- Shard2
    Shard2 -[hidden]right- Shard3
}

' ==========================================
' 业务请求流向 (粗实线)
' ==========================================
LB =down=> Spider1 : SQL 请求
LB =down=> Spider2 : SQL 请求

Spider1 =down=> Shard1 : 路由查询
Spider1 =down=> Shard2
Spider1 =down=> Shard3

Spider2 =down=> Shard1
Spider2 =down=> Shard2
Spider2 =down=> Shard3

' ==========================================
' 控制流 (虚线)
' ==========================================
ControlNode .down.> Spider1 : 下发路由表
ControlNode .down.> Spider2

ControlNode .down.> Shard1 : 监控与调度
ControlNode .down.> Shard2
ControlNode .down.> Shard3

@enduml
