@startuml
!theme plain
skinparam componentStyle uml2
skinparam defaultFontName "SimHei"
skinparam linetype ortho
skinparam nodesep 100
skinparam ranksep 100

' 强制从左到右布局
left to right direction

' ==========================================
' 源端区域
' ==========================================
rectangle "源端区域" as SourceZone #E3F2FD {
    database "源数据库\n(MySQL)" as SourceDB
}

' ==========================================
' 迁移系统部署区域
' ==========================================
rectangle "迁移系统部署区域" as SystemZone #FFF9C4 {
    
    component "Web 管理平台" as WebConsole
    
    node "同步引擎集群\n(HA 双节点)" as EngineCluster #E1F5FE
    
    database "元数据存储\n(Etcd 集群)" as MetaStore
    
    ' 强制垂直排列
    WebConsole -[hidden]down- EngineCluster
    EngineCluster -[hidden]down- MetaStore
}

' ==========================================
' 目标端区域
' ==========================================
rectangle "目标端区域" as TargetZone #E8F5E9 {
    
    component "控制节点\n(路由管理)" as ControlNode
    
    component "路由层\n(Spider Nodes)" as RouterLayer
    
    folder "存储层" as StorageLayer {
        database "分片组 1" as Shard1
        database "分片组 2" as Shard2
        database "分片组 3" as Shard3
        
        ' 横向排列
        Shard1 -[hidden]right- Shard2
        Shard2 -[hidden]right- Shard3
    }
    
    queue "消息队列\n(Kafka)" as MsgQueue
    
    ' 强制垂直排列
    ControlNode -[hidden]down- RouterLayer
    RouterLayer -[hidden]down- StorageLayer
}

' ==========================================
' 连接关系
' ==========================================

' Web -> Engine
WebConsole .down.> EngineCluster : HTTP 管理

' Engine <-> Meta
EngineCluster <--> MetaStore : gRPC\n(元数据读写)

' Source -> Engine (主要数据流)
SourceDB =right=> EngineCluster : **Binlog 订阅**\n(MySQL Replication)

' Engine -> Target Control
EngineCluster .right.> ControlNode : 获取路由表\n(HTTP/gRPC)

' Engine -> Target Storage (主要写入流)
EngineCluster ==right=> Shard1 : **MySQL Protocol**\n(直连写入)
EngineCluster ==right=> Shard2
EngineCluster ==right=> Shard3

' Engine -> Kafka (可选)
EngineCluster ..> MsgQueue : Kafka Producer\n(变更订阅)

@enduml
