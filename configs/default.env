# Bifrost同步任务配置模板
# 使用方法: bash setup_bifrost_example.sh configs/default.env

# ==================== Bifrost服务配置 ====================
export BIFROST_URL="https://127.0.0.1:21036"        # Bifrost服务地址
export BIFROST_USER="Bifrost"                        # Bifrost用户名
export BIFROST_PASS="Bifrost123"                     # Bifrost密码

# ==================== 源MySQL配置 ====================
export SOURCE_HOST="127.0.0.1"                      # 源MySQL地址
export SOURCE_PORT="33063"                          # 源MySQL端口
export SOURCE_USER="root"                           # 源MySQL用户
export SOURCE_PASS="root"                           # 源MySQL密码
export SOURCE_DB="sysbench"                         # 源数据库名

# ==================== 目标MySQL配置 ====================
export TARGET_HOST="127.0.0.1"                      # 目标MySQL地址
export TARGET_PORT="33064"                          # 目标MySQL端口
export TARGET_USER="root"                           # 目标MySQL用户
export TARGET_PASS="root"                           # 目标MySQL密码
export TARGET_DB="sysbench"                         # 目标数据库名

# ==================== 同步表配置 ====================
# 要同步的表列表（空格分隔）
export TABLES="sbtest1 sbtest2 sbtest3 sbtest4 sbtest5 sbtest6 sbtest7 sbtest8 sbtest9 sbtest10"

# ==================== 全量同步性能参数 ====================
# 这些参数对全量同步速度影响很大，请根据实际环境调整
export HISTORY_THREAD_NUM=16          # 读取线程数（从源库并行读取）
export HISTORY_THREAD_COUNT_PER=10000 # 每个线程每次读取的行数
export HISTORY_SYNC_THREAD_NUM=30    # 写入线程数（向目标库并行写入）
export HISTORY_LIMIT_OPTIMIZE=1       # LIMIT优化开关（1=启用）

# 参数调优建议:
# - HISTORY_SYNC_THREAD_NUM 建议设置为 HISTORY_THREAD_NUM 的 2-4 倍
# - HISTORY_THREAD_COUNT_PER 越大单次读取越多，但内存占用也越大
# - 小表(<10万行): ThreadNum=2, SyncThreadNum=4, ThreadCountPer=5000
# - 中表(10-100万): ThreadNum=8, SyncThreadNum=16, ThreadCountPer=10000  
# - 大表(>100万行): ThreadNum=40, SyncThreadNum=100, ThreadCountPer=15000

# ==================== 压测配置 ====================
# 是否启用sysbench增量压测 (true/false)
export ENABLE_SYSBENCH=false

# sysbench压测参数（仅当ENABLE_SYSBENCH=true时生效）
# 注意: SYSBENCH_TABLES 应该与上面 TABLES 中配置的表数量匹配
export SYSBENCH_THREADS=5           # 压测线程数
export SYSBENCH_TIME=20             # 压测时长（秒）
export SYSBENCH_TABLES=1            # 压测表数量（与TABLES数量一致）
export SYSBENCH_TABLE_SIZE=200000   # 每张表的数据量

# ==================== 校验配置 ====================
# 全量同步完成后，等待多久再执行checksum校验（秒）
# 建议值：10-30秒，确保目标库数据完全落盘，避免误报
export CHECKSUM_WAIT_TIME=10
