# Bifrost同步任务示例配置 - IDC环境
# 使用方法: bash setup_bifrost_example.sh configs/task_example.env

# ==================== Bifrost服务配置 ====================
export BIFROST_URL="https://127.0.0.1:21036"
export BIFROST_USER="Bifrost"
export BIFROST_PASS="Bifrost123"

# ==================== 源MySQL配置 ====================
export SOURCE_HOST="11.150.106.237"
export SOURCE_PORT="20000"
export SOURCE_USER="root"
export SOURCE_PASS="root"
export SOURCE_DB="sysbench"

# ==================== 目标MySQL配置 ====================
export TARGET_HOST="127.0.0.1"
export TARGET_PORT="33064"
export TARGET_USER="root"
export TARGET_PASS="root"
export TARGET_DB="sysbench"

# ==================== 同步表配置 ====================
export TABLES="sbtest1 sbtest2 sbtest3"

# ==================== 压测配置 ====================
# 禁用增量压测（因为源库可能是IDC环境，不需要本地压测）
export ENABLE_SYSBENCH=false

# 以下参数仅在ENABLE_SYSBENCH=true时生效
export SYSBENCH_THREADS=10
export SYSBENCH_TIME=30
export SYSBENCH_TABLES=3
export SYSBENCH_TABLE_SIZE=200000
