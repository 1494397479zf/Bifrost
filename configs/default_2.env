# Bifrost同步任务配置模板 - 库2
# 使用方法: bash setup_bifrost.sh configs/default_2.env

# ==================== Bifrost服务配置 ====================
export BIFROST_URL="https://127.0.0.1:21036"
export BIFROST_USER="Bifrost"
export BIFROST_PASS="Bifrost123"

# ==================== 源MySQL配置 ====================
export SOURCE_HOST="11.150.106.237"
export SOURCE_PORT="20000"
export SOURCE_USER="root"
export SOURCE_PASS="root"
export SOURCE_DB="sysbench_1"                   # ← 关键：带 _1 后缀

# ==================== 目标MySQL配置 ====================
export TARGET_HOST="21.217.142.213"
export TARGET_PORT="20000"
export TARGET_USER="root"
export TARGET_PASS="root"
export TARGET_DB="sysbench_1"                   # ← 关键：带 _1 后缀

# ==================== 同步表配置 ====================
export TABLES="sbtest1 sbtest2 sbtest3 sbtest4 sbtest5"

# ==================== Binlog配置 ====================
# 这些会被脚本自动获取，这里是默认值
export BINLOG_FILE="${BINLOG_FILE:-}"
export BINLOG_POS="${BINLOG_POS:-}"

# ==================== 全量同步性能参数 ====================
export HISTORY_THREAD_NUM=16
export HISTORY_THREAD_COUNT_PER=10000
export HISTORY_SYNC_THREAD_NUM=30
export HISTORY_LIMIT_OPTIMIZE=1

# ==================== 压测配置 ====================
export ENABLE_SYSBENCH=false
export SYSBENCH_THREADS=5
export SYSBENCH_TIME=20
export SYSBENCH_TABLES=5
export SYSBENCH_TABLE_SIZE=200000

# ==================== 校验配置 ====================
export CHECKSUM_WAIT_TIME=10
